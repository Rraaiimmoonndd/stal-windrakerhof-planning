rules_version = '2';

// Iedereen met de link mag lezen en schrijven, maar alleen in de vorm die de planning gebruikt:
//   planning/notities            { text }
//   planning/vast                { Maandag: { buiten1: { naam, vast }, buitenTijd: { naam, vast }, ... }, ... }
//   planning/week-JJJJ-MM-DD     { Maandag: { buiten1: "naam", buitenTijd: "08:00", ... }, ... }
// Verwijderen kan niet, en namen/tijden/notities hebben een maximale lengte.
//
// Alleen de dagen die bij een opslag veranderen worden gecontroleerd. Firebase staat per
// opslag maar een beperkt aantal controles toe; het hele document nalopen liep daarop vast
// zodra er veel vaste namen waren.
service cloud.firestore {
  match /databases/{database}/documents {

    function days() {
      return ['Maandag', 'Dinsdag', 'Woensdag', 'Donderdag', 'Vrijdag', 'Zaterdag', 'Zondag'];
    }
    function fields() {
      return ['buiten1', 'buiten2', 'binnen1', 'binnen2', 'buitenTijd', 'binnenTijd'];
    }

    // Dagen die deze opslag toevoegt of wijzigt.
    function changedDays() {
      return resource == null
        ? request.resource.data.keys().toSet()
        : request.resource.data.diff(resource.data).affectedKeys();
    }

    function okText(m, f) {
      return !(f in m) || (m[f] is string && m[f].size() <= 40);
    }
    function okWeekDay(day) {
      return day is map && day.keys().hasOnly(fields())
        && okText(day, 'buiten1') && okText(day, 'buiten2')
        && okText(day, 'binnen1') && okText(day, 'binnen2')
        && okText(day, 'buitenTijd') && okText(day, 'binnenTijd');
    }

    function okVastEntry(m, f) {
      return !(f in m) || (m[f] is map && m[f].keys().hasOnly(['naam', 'vast'])
        && okText(m[f], 'naam')
        && (!('vast' in m[f]) || m[f].vast is bool));
    }
    function okVastDay(day) {
      return day is map && day.keys().hasOnly(fields())
        && okVastEntry(day, 'buiten1') && okVastEntry(day, 'buiten2')
        && okVastEntry(day, 'binnen1') && okVastEntry(day, 'binnen2')
        && okVastEntry(day, 'buitenTijd') && okVastEntry(day, 'binnenTijd');
    }

    // Controleer alleen gewijzigde dagen; welke controle hoort bij het document staat in isVast.
    function okDay(data, ch, d, isVast) {
      return !(d in ch) || (isVast ? okVastDay(data[d]) : okWeekDay(data[d]));
    }
    function okSchedule(data, isVast) {
      let ch = changedDays();
      return data.keys().hasOnly(days())
        && okDay(data, ch, 'Maandag', isVast) && okDay(data, ch, 'Dinsdag', isVast)
        && okDay(data, ch, 'Woensdag', isVast) && okDay(data, ch, 'Donderdag', isVast)
        && okDay(data, ch, 'Vrijdag', isVast) && okDay(data, ch, 'Zaterdag', isVast)
        && okDay(data, ch, 'Zondag', isVast);
    }

    function okNotes(data) {
      return data.keys().hasOnly(['text']) && data.text is string && data.text.size() <= 4000;
    }

    function okWrite(docId, data) {
      return (docId == 'notities' && okNotes(data))
        || (docId == 'vast' && okSchedule(data, true))
        || (docId.matches('week-[0-9]{4}-[0-9]{2}-[0-9]{2}') && okSchedule(data, false));
    }

    match /planning/{docId} {
      allow read: if true;
      allow create, update: if okWrite(docId, request.resource.data);
      allow delete: if false;
    }
  }
}
